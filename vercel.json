{
  "cleanUrls": true,
  "redirects": [
    { "source": "/phones", "destination": "/shop?d=phones", "permanent": false },
    { "source": "/computers", "destination": "/shop?d=compute", "permanent": false },
    { "source": "/accessories", "destination": "/shop", "permanent": false },
    { "source": "/repair", "destination": "/#services", "permanent": false }
  ],
  "headers": [
    { "source": "/catalog.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/products/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
